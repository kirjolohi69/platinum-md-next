+    netmd_error close_error = presence_descriptor_reply(reply, length);
+    if (error != NETMD_NO_ERROR) return error;
+    if (close_error != NETMD_NO_ERROR) return close_error;
+    *present = candidate;
+    netmd_log(NETMD_LOG_VERBOSE, "disc present: %s\n", candidate ? "yes" : "no");
+    return NETMD_NO_ERROR;
+}
