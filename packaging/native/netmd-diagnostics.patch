+static netmd_error status_reply(const unsigned char* reply, int length)
+{
+    if (length < 0) return NETMD_USB_ERROR;
+    if (length < 1) return NETMD_RESPONSE_TO_SHORT;
+    if (reply[0] != NETMD_STATUS_ACCEPTED && reply[0] != NETMD_STATUS_IMPLEMENTED)
+        return NETMD_RESPONSE_NOT_EXPECTED;
+    return NETMD_NO_ERROR;
+}
+
+static void log_presence_reply(const char* stage, const unsigned char* reply, int length)
+{
+    /* Only this small read-only status exchange is logged, never disc titles
+     * or audio. One bounded line preserves the reply before descriptor close. */
+    char hex[64 * 3 + 1] = {0};
+    int shown = length < 64 ? length : 64;
+    for (int i = 0; i < shown; i++) snprintf(hex + i * 3, 4, "%02x ", reply[i]);
+    if (shown > 0) hex[shown * 3 - 1] = '\0';
+    netmd_log(NETMD_LOG_VERBOSE, "disc presence %s: %d bytes [%s]%s\n",
+              stage, length, hex, length > 64 ? " (first 64 bytes)" : "");
+}
+
+static netmd_error presence_descriptor_reply(const unsigned char* reply, int length)
+{
+    /* netmd-js treats descriptor housekeeping as best effort. An explicit
+     * rejection/unsupported response is safe to tolerate ONLY because a
+     * separately validated status reply decides presence. Never ignore a
+     * failed transport or an empty/malformed reply. */
+    if (length > 0 && (reply[0] == NETMD_STATUS_REJECTED ||
+                       reply[0] == NETMD_STATUS_NOT_IMPLEMENTED)) {
+        netmd_log(NETMD_LOG_VERBOSE,
+                  "disc presence descriptor declined (0x%02x); using the status response\n", reply[0]);
+        return NETMD_NO_ERROR;
+    }
+    return status_reply(reply, length);
+}
+
+netmd_error netmd_get_disc_presence(netmd_dev_handle* dev, int* present)
+{
+    /* netmd-js getStatus/isDiscPresent: open the operating-status descriptor,
+     * read its length-prefixed data, then close it. Payload byte 4 is 0x40
+     * when a disc is present; all other values mean not present. This only
+     * classifies media after the complete status reply has been validated. */
+    unsigned char descriptor[] = {0x00, 0x18, 0x08, 0x80, 0x00, 0x01, 0x00};
+    unsigned char request[] = {0x00, 0x18, 0x09, 0x80, 0x01, 0x02, 0x30, 0x88,
+        0x00, 0x00, 0x30, 0x88, 0x04, 0x00, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00};
+    const unsigned char prefix[] = {0x18, 0x09, 0x80, 0x01, 0x02, 0x30, 0x88,
+        0x00, 0x00, 0x30, 0x88, 0x04, 0x00, 0x10, 0x00, 0x00, 0x09, 0x00, 0x00};
+    unsigned char reply[255] = {0};
+    int length = netmd_exch_message(dev, descriptor, sizeof(descriptor), reply);
+    log_presence_reply("open", reply, length);
+    netmd_error error = presence_descriptor_reply(reply, length);
+    if (error != NETMD_NO_ERROR) return error;
+
+    memset(reply, 0, sizeof(reply));
+    length = netmd_exch_message(dev, request, sizeof(request), reply);
+    log_presence_reply("status", reply, length);
+    if (length < 0) return NETMD_USB_ERROR; /* Do not send more on a failed USB exchange. */
+    error = status_reply(reply, length);
+    int candidate = -1;
+    if (error == NETMD_NO_ERROR) {
+        if (length < 27) {
+            netmd_log(NETMD_LOG_VERBOSE, "disc presence status is too short (minimum 27 bytes)\n");
+            error = NETMD_RESPONSE_TO_SHORT;
+        } else if (memcmp(reply + 1, prefix, sizeof(prefix)) != 0) {
+            netmd_log(NETMD_LOG_VERBOSE, "disc presence status header does not match\n");
+            error = NETMD_RESPONSE_NOT_EXPECTED;
+        } else if (((unsigned int)reply[20] * 256 + reply[21]) != (unsigned int)(length - 22)) {
+            netmd_log(NETMD_LOG_VERBOSE, "disc presence payload length mismatch: declared %u, received %d\n",
+                      (unsigned int)reply[20] * 256 + reply[21], length - 22);
+            error = NETMD_RESPONSE_NOT_EXPECTED;
+        } else {
+            candidate = reply[26] == 0x40;
+            netmd_log(NETMD_LOG_VERBOSE, "disc presence flag: 0x%02x (%s)\n",
